# API Keys & Secrets
GEMINI_API_KEY=your_gemini_api_key_here
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_here

# Paths & Directories
CHROMA_PERSIST_DIR=./db/chroma
SQLITE_DB_PATH=./db/machina.db
DATASET_PATH=./data/machine_logs.json
SAMPLE_PDF_PATH=./data/sample_machine_logs.pdf

# Telemetry Settings
ANONYMIZED_TELEMETRY=False
CHROMA_TELEMETRY=False

# Inference Settings (Hugging Face / LLM)
HF_MODEL_ID=tiiuae/falcon-7b-instruct
HF_MAX_NEW_TOKENS=1024
HF_TEMPERATURE=0.15
HF_TIMEOUT_SECS=120

# Embedding model & RAG Settings
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=4
